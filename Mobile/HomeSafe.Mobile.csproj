<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' != 'Windows_NT' and !$([MSBuild]::IsOSPlatform('osx'))">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' or '$(EnableWindowsTargeting)' == 'true'">net10.0-windows10.0.19041.0;$(TargetFrameworks)</TargetFrameworks>
    <TargetFrameworks Condition="'$(HomeSafeWindowsOnly)' == 'true'">net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64;android-x64</RuntimeIdentifiers>
    <RootNamespace>HomeSafe.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>HomeSafe</ApplicationTitle>
    <ApplicationId>org.homesafe.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' and '$(HomeSafePush)' == 'true'">
    <CodesignEntitlements>Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(HomeSafeCriticalAlerts)' == 'true'">Platforms/iOS/CriticalEntitlements.plist</CodesignEntitlements>
    <DefineConstants Condition="'$(HomeSafeCriticalAlerts)' == 'true'">$(DefineConstants);HOMESAFE_CRITICAL_ALERTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/HomeSafe.Shared.csproj" />
    <AssemblyMetadata Include="HomeSafeTrustedServers" Value="$(HomeSafeTrustedServers)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <MauiIcon Include="Resources/AppIcon/icon.svg" Color="#2258E7" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#2258E7" BaseSize="160,160" />
    <MauiAsset Include="Resources/AppAssets/**" Exclude="Resources/AppAssets/alarm.wav" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="124.1.2" />
    <GoogleServicesJson Include="google-services.json" Condition="Exists('google-services.json')" />
  </ItemGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <MauiAsset Include="Resources/AppAssets/alarm.wav" LogicalName="alarm.wav" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <BundleResource Include="Resources/AppAssets/alarm.wav" LogicalName="alarm.wav" />
  </ItemGroup>
</Project>
